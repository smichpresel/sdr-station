[Unit]
Description=SDR Station Web Launcher, Auto-Cycler and Spotter Hub
After=network.target postgresql.service

[Service]
Type=simple
User=pi
EnvironmentFile=-/etc/default/sdr-station
WorkingDirectory=/opt/sdr-station/launcher
ExecStart=/usr/bin/python3 /opt/sdr-station/launcher/launcher_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
