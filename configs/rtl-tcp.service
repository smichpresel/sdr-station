[Unit]
Description=RTL-TCP Raw IQ Network Server on Port 1234
After=network.target
Conflicts=readsb.service ais-catcher.service sdr-voice-web.service rtl-433-web.service soapyremote-server.service

[Service]
Type=simple
User=pi
ExecStart=/usr/bin/rtl_tcp -a 0.0.0.0 -p 1234
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
