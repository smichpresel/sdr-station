[Unit]
Description=SDR Live Voice and Scanner Web Receiver
After=network.target
Conflicts=readsb.service ais-catcher.service rtl-433-web.service rtl-tcp.service soapyremote-server.service

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/sdr-station/voice-receiver
ExecStart=/usr/bin/python3 /opt/sdr-station/voice-receiver/voice_server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
